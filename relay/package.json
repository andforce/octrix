{
  "name": "cli-bridge-relay",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run build:site && tsc -p tsconfig.build.json",
    "build:server": "tsc -p tsconfig.build.json",
    "build:site": "npm --prefix site run build",
    "start": "node dist/index.js",
    "test": "vitest run --exclude 'site/**' && npm --prefix site test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@alicloud/dypnsapi20170525": "^2.0.0",
    "@alicloud/openapi-core": "^1.0.7",
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "jose": "^5.9.6",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "4.1.4",
    "find-my-way": "9.9.0",
    "ip-address": "10.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0"
  }
}
