# 对外 HTTPS 域名；它会用于 OAuth 回调、浏览器授权链接和 iOS 回调。
OCTRIX_PUBLIC_URL=https://relay.example.com
OCTRIX_TOKEN_PEPPER=replace-with-at-least-32-random-bytes

# 独立的 Octrix Google OAuth 应用，回调地址：
# https://relay.example.com/auth/google/callback
OCTRIX_GOOGLE_OAUTH_CLIENT_ID=
OCTRIX_GOOGLE_OAUTH_CLIENT_SECRET=
OCTRIX_GOOGLE_ALLOWED_EMAILS=user@gmail.com

# Sign in with Apple Web：Services ID 与回调地址必须在 Apple Developer 中登记并关联主 App ID。
# 回调地址：https://relay.example.com/auth/apple/callback
# 私钥使用 `base64 < AuthKey_XXXXXXXXXX.p8 | tr -d '\n'` 编码后写入受控环境文件。
OCTRIX_APPLE_OAUTH_CLIENT_ID=
# iOS 原生登录使用 App 的 Bundle ID；与上面的 Web Services ID 分开校验。
OCTRIX_APPLE_NATIVE_CLIENT_ID=com.octrix.mobile
OCTRIX_APPLE_OAUTH_TEAM_ID=
OCTRIX_APPLE_OAUTH_KEY_ID=
OCTRIX_APPLE_OAUTH_PRIVATE_KEY_BASE64=

# 已确认可用于 Octrix 的阿里云号码认证配置，可使用系统赠送或自定义签名/模板
OCTRIX_ALIYUN_ACCESS_KEY_ID=
OCTRIX_ALIYUN_ACCESS_KEY_SECRET=
OCTRIX_ALIYUN_DYPNS_ENDPOINT=dypnsapi.aliyuncs.com
OCTRIX_SMS_SIGN_NAME=
OCTRIX_SMS_TEMPLATE_CODE=
OCTRIX_SMS_SCHEME_NAME=
OCTRIX_SMS_ALLOWED_PHONES=+8613800138000

# App Review 专用账号：手机号和固定验证码只写入受控部署环境，不提交真实值。
# 审核手机号不发送真实短信，但仍需完成 challenge 与验证码校验流程。
OCTRIX_APP_REVIEW_SMS_PHONES=
OCTRIX_APP_REVIEW_SMS_CODE=

OCTRIX_WEB_SESSION_TTL_SECONDS=2592000
OCTRIX_SMS_CODE_TTL_SECONDS=300
OCTRIX_AUTHORIZATION_TTL_SECONDS=600
OCTRIX_AUTHORIZATION_POLL_SECONDS=2

# 使用系统赠送配置时，填写控制台展示的签名名称和模板 CODE，例如登录模板 100001。
# 迁移期最多开启 7 天。开启时必须填写明确截止时间；全部设备重新授权后立即关闭并删除旧凭据。
OCTRIX_LEGACY_AUTH_ENABLED=false
OCTRIX_LEGACY_AUTH_UNTIL=
RELAY_TOKEN=
