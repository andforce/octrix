MAC_SIGNING_IDENTITY=Developer ID Application: Your Name (TEAMID)

# 默认从 ~/.appstoreconnect/config.json 读取 ASC API Key；请勿将私钥或认证配置放入仓库。
# 仅在使用其他项目外配置路径时设置：
# ASC_CONFIG_PATH=/absolute/path/to/config.json

# Fallback notarization auth if ASC_CONFIG_PATH is not available:
# APPLE_ID=your-apple-id@example.com
# APPLE_TEAM_ID=TEAMID1234
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

TAURI_PRODUCT_NAME=Octrix
TAURI_TARGETS=aarch64-apple-darwin,x86_64-apple-darwin
