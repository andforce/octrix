{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Octrix",
  "identifier": "com.octrix.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../dist-server/",
      "../dist/",
      "../dist-runtime/",
      "../host/"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
